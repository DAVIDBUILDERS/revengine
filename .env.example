# Use .env.fixture.example for offline work. Never populate fixture mode with real credentials.
DAVID_MODE=shadow
DAVID_DEPLOYMENT=test
DAVID_LIVE_EXECUTION=false
APP_ORIGIN=https://YOUR-TEST-APP.vercel.app
EXPECTED_VERCEL_PROJECT_ID=
EXPECTED_SUPABASE_PROJECT_ID=
PRODUCTION_SUPABASE_PROJECT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Use separate restricted LOGIN roles, never postgres/service_role in runtime.
WORKER_DATABASE_URL=
DISPATCHER_DATABASE_URL=
DAVID_OAUTH_DATABASE_URL=
DATABASE_CA_CERT=
CRON_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-TEST-APP.vercel.app/api/google/callback
AI_GATEWAY_API_KEY=
AI_MODEL_ID=
AI_ALLOWED_PROVIDER=
AI_MAX_JOB_COST_MINOR=
AI_MAX_OUTPUT_TOKENS=600
# Migration credentials belong only in a protected shell/CI job, not Vercel.
# MIGRATION_DATABASE_URL=
# CONFIRMED_DATABASE_PROJECT_ID=
